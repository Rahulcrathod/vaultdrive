# VaultDrive Deployment Environment Variables Example
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://your-app-name.onrender.com
SESSION_SECRET=vaultdrive_super_secure_production_secret_key_random_hash

# User Storage Quotas (2 GB default)
USER_QUOTA_BYTES=2147483648
MAX_UPLOAD_BYTES=2147483648

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://username:password@cluster0.nzkedls.mongodb.net/vaultdrive?retryWrites=true&w=majority

# Gmail SMTP Email Provider (Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="VaultDrive Security" <your_email@gmail.com>

# (Optional) AWS S3 or Cloudflare R2 Object Storage
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your_s3_bucket
