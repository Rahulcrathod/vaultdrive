NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional: MongoDB Atlas or local MongoDB
# If left commented or unconfigured, VaultDrive automatically uses local file-backed store
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/vaultdrive

SESSION_SECRET=vaultdrive_development_secret_3892018490218490

# Optional: AWS S3 Object Storage
# If left blank, VaultDrive automatically uses the local encrypted object vault in server/data/vault/
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-private-vaultdrive-bucket
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

SESSION_MAX_AGE_MS=28800000
MAX_UPLOAD_BYTES=2147483648
USER_QUOTA_BYTES=2147483648

# Optional: Custom SMTP Email Provider (e.g., Gmail, SendGrid, Resend)
# If left blank, development mode automatically previews sent emails via Ethereal & server logs
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="VaultDrive Security" <security@vaultdrive.app>

